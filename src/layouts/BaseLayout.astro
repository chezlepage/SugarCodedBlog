---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.7;
        color: #E6EEF6;
        background: linear-gradient(135deg, #0F1720 0%, #1a2332 100%);
        min-height: 100vh;
      }

      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }

      header {
        padding: 2.5rem 0 2rem;
        margin-bottom: 2rem;
      }

      header h1 {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.5px;
      }

      header a {
        color: #ffffff;
        text-decoration: none;
        transition: opacity 0.2s ease;
      }

      header a:hover {
        opacity: 0.8;
      }

      footer {
        margin-top: 4rem;
        padding: 2rem 0;
        color: rgba(230, 238, 246, 0.6);
        font-size: 0.9rem;
        text-align: center;
      }

      main {
        min-height: 60vh;
        background: #15202B;
        border-radius: 16px;
        padding: 3rem 2.5rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(43, 109, 246, 0.1);
      }

      @media (max-width: 768px) {
        main {
          padding: 2rem 1.5rem;
          border-radius: 12px;
        }

        header h1 {
          font-size: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <h1><a href="/">Sugar Coded Games</a></h1>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <p>&copy; {new Date().getFullYear()} Sugar Coded Games</p>
      </footer>
    </div>
  </body>
</html>
