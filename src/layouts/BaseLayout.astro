---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        /* Existing palette (no new colors; just centralized) */
        --bg-0: #0F1720;
        --bg-1: #1a2332;
        --panel: #15202B;
        --text: #E6EEF6;
        --muted: rgba(230, 238, 246, 0.65);

        --accent-0: #2B6DF6;
        --accent-1: #3B82F6;
        --ring: rgba(43, 109, 246, 0.25);
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.7;
        color: var(--text);
        background: linear-gradient(135deg, var(--bg-0) 0%, var(--bg-1) 100%);
        min-height: 100vh;
      }

      /* Animated background overlay (disabled for reduced motion) */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: -1;

        /* Use existing palette (dark base + brand blues) */
        background:
          radial-gradient(1100px 720px at 10% 20%, rgba(43, 109, 246, 0.28) 0%, rgba(43, 109, 246, 0) 62%),
          radial-gradient(1000px 680px at 90% 30%, rgba(59, 130, 246, 0.22) 0%, rgba(59, 130, 246, 0) 64%),
          radial-gradient(900px 600px at 55% 90%, rgba(43, 109, 246, 0.18) 0%, rgba(43, 109, 246, 0) 66%);
        filter: blur(22px) saturate(1.15);
        opacity: 1;
        transform: translate3d(0, 0, 0) scale(1.08);
        animation: bg-drift 28s ease-in-out infinite;
      }

      /* A tiny bit of animated grain so it feels alive */
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: -1;

        background:
          repeating-linear-gradient(
            0deg,
            rgba(230, 238, 246, 0.035) 0px,
            rgba(230, 238, 246, 0.035) 1px,
            rgba(230, 238, 246, 0) 2px,
            rgba(230, 238, 246, 0) 4px
          ),
          repeating-linear-gradient(
            90deg,
            rgba(0, 0, 0, 0.035) 0px,
            rgba(0, 0, 0, 0.035) 1px,
            rgba(0, 0, 0, 0) 2px,
            rgba(0, 0, 0, 0) 5px
          );
        mix-blend-mode: overlay;
        opacity: 0.22;
        transform: translate3d(0, 0, 0);
        animation: grain-shift 10s steps(6) infinite;
      }

      @keyframes bg-drift {
        0% {
          transform: translate3d(-1.5%, -1%, 0) scale(1.05);
          opacity: 0.8;
        }
        50% {
          transform: translate3d(1.5%, 1%, 0) scale(1.07);
          opacity: 0.95;
        }
        100% {
          transform: translate3d(-1.5%, -1%, 0) scale(1.05);
          opacity: 0.8;
        }
      }

      @keyframes grain-shift {
        0% {
          transform: translate3d(0, 0, 0);
        }
        25% {
          transform: translate3d(-1.25%, 0.75%, 0);
        }
        50% {
          transform: translate3d(1.25%, -0.5%, 0);
        }
        75% {
          transform: translate3d(-0.75%, -1%, 0);
        }
        100% {
          transform: translate3d(0, 0, 0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        body::before {
          animation: none;
        }
        body::after {
          animation: none;
        }
      }

      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }

      header {
        padding: 2.5rem 0 2rem;
        margin-bottom: 2rem;
      }

      header h1 {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.5px;
      }

      header a {
        color: #ffffff;
        text-decoration: none;
        transition: opacity 0.2s ease;
      }

      header a:hover {
        opacity: 0.8;
      }

      footer {
        margin-top: 4rem;
        padding: 2rem 0;
        color: rgba(230, 238, 246, 0.6);
        font-size: 0.9rem;
        text-align: center;
      }

      main {
        min-height: 60vh;
        position: relative;
        background: rgba(21, 32, 43, 0.62);
        border-radius: 16px;
        padding: 3rem 2.5rem;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(43, 109, 246, 0.18);
        backdrop-filter: blur(10px);
      }

      main::before {
        content: '';
        position: absolute;
        inset: -1px;
        border-radius: 16px;
        pointer-events: none;
        background: linear-gradient(
          135deg,
          rgba(43, 109, 246, 0.22) 0%,
          rgba(43, 109, 246, 0) 32%,
          rgba(59, 130, 246, 0.18) 68%,
          rgba(59, 130, 246, 0) 100%
        );
        mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        padding: 1px;
        opacity: 0.9;
      }

      @media (max-width: 768px) {
        main {
          padding: 2rem 1.5rem;
          border-radius: 12px;
        }

        header h1 {
          font-size: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <h1><a href="/">Sugar Coded Games</a></h1>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <p>&copy; {new Date().getFullYear()} Sugar Coded Games</p>
      </footer>
    </div>
  </body>
</html>
