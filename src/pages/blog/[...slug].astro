---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title}>
  <style>
    article {
      max-width: 100%;
    }

    .post-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 2px solid rgba(43, 109, 246, 0.2);
      text-align: center;
    }

    .post-title {
      font-size: 2.75rem;
      margin-bottom: 1rem;
      font-weight: 800;
      line-height: 1.2;
      background: linear-gradient(135deg, #2B6DF6 0%, #3B82F6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .post-date {
      color: #9FB0C3;
      font-size: 1rem;
      font-weight: 500;
    }

    .post-content {
      font-size: 1.1rem;
      line-height: 1.8;
      color: #E6EEF6;
    }

    .post-content :global(h2) {
      font-size: 2rem;
      margin: 2.5rem 0 1.25rem;
      font-weight: 700;
      color: #E6EEF6;
    }

    .post-content :global(h3) {
      font-size: 1.5rem;
      margin: 2rem 0 1rem;
      font-weight: 600;
      color: #E6EEF6;
    }

    .post-content :global(p) {
      margin-bottom: 1.5rem;
      color: #9FB0C3;
    }

    .post-content :global(ul),
    .post-content :global(ol) {
      margin: 1.5rem 0;
      padding-left: 2rem;
    }

    .post-content :global(li) {
      margin-bottom: 0.75rem;
      color: #9FB0C3;
    }

    .post-content :global(strong) {
      color: #E6EEF6;
      font-weight: 600;
    }

    .post-content :global(code) {
      background: rgba(43, 109, 246, 0.1);
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-size: 0.9em;
      font-family: 'Courier New', monospace;
      border: 1px solid rgba(43, 109, 246, 0.2);
      color: #2B6DF6;
      font-weight: 500;
    }

    .post-content :global(pre) {
      background: rgba(15, 23, 32, 0.8);
      padding: 1.5rem;
      border-radius: 8px;
      overflow-x: auto;
      margin: 2rem 0;
      border: 1px solid rgba(43, 109, 246, 0.2);
    }

    .post-content :global(pre code) {
      background: none;
      padding: 0;
      color: #E6EEF6;
      border: none;
    }

    .post-content :global(blockquote) {
      border-left: 4px solid #2B6DF6;
      padding-left: 1.5rem;
      margin: 2rem 0;
      font-style: italic;
      color: #9FB0C3;
    }

    .post-content :global(a) {
      color: #2B6DF6;
      text-decoration: none;
      transition: color 0.2s ease;
      font-weight: 500;
    }

    .post-content :global(a:hover) {
      color: #3B82F6;
      text-decoration: underline;
    }

    .back-link {
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 2px solid rgba(43, 109, 246, 0.2);
      text-align: center;
    }

    .back-link a {
      display: inline-block;
      color: #2B6DF6;
      text-decoration: none;
      font-weight: 600;
      padding: 0.75rem 2rem;
      border: 2px solid #2B6DF6;
      border-radius: 8px;
      transition: all 0.3s ease;
    }

    .back-link a:hover {
      background: linear-gradient(135deg, #2B6DF6 0%, #3B82F6 100%);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(43, 109, 246, 0.4);
    }

    @media (max-width: 768px) {
      .post-title {
        font-size: 2rem;
      }

      .post-content {
        font-size: 1.05rem;
      }

      .post-content :global(h2) {
        font-size: 1.6rem;
      }

      .post-content :global(h3) {
        font-size: 1.3rem;
      }
    }
  </style>

  <article>
    <header class="post-header">
      <h1 class="post-title">{entry.data.title}</h1>
      <time class="post-date">
        {entry.data.date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        })}
      </time>
    </header>
    <div class="post-content">
      <Content />
    </div>
    <div class="back-link">
      <a href="/">&larr; Back to home</a>
    </div>
  </article>
</BaseLayout>
